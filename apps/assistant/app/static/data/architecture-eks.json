  "flows": [
    {
      "id": "build",
      "name": "Build & push",
      "color": {
        "dark": "#5da9e9",
        "light": "#2a63a8"
      },
      "steps": [
        {
          "edges": [
            "b1"
          ],
          "text": "An engineer pushes to main."
        },
        {
          "edges": [
            "b2",
            "b3"
          ],
          "text": "ci builds the API image; the assistant workflow runs the tests and eval, then builds ExitZero. Both images are scanned by Trivy."
        },
        {
          "edges": [
            "b4",
            "b5"
          ],
          "text": "On main, both images go to ECR, tagged with the commit SHA."
        },
        {
          "edges": [
            "b6"
          ],
          "text": "Planned: once ExitZero's manifests exist, the nodes pull its image from ECR by SHA (the node role already has ECR read access)."
        }
      ]
    },
    {
      "id": "lab",
      "name": "Lab day: up and down",
      "color": {
        "dark": "#a3b4b7",
        "light": "#4c6063"
      },
      "steps": [
        {
          "edges": [
            "u1"
          ],
          "text": "eks-up.ps1 reads your public IP, then applies the network stack: VPC, subnets, internet gateway and one NAT gateway."
        },
        {
          "edges": [
            "u2"
          ],
          "text": "It applies the eks stack with your IP as the only CIDR allowed on the API endpoint, and writes a kubeconfig context."
        },
        {
          "edges": [
            "u5"
          ],
          "text": "The node group joins: free-tier-eligible c7i-flex.large, IMDSv2 with hop limit 1, VPC CNI with network policy on."
        },
        {
          "edges": [
            "u3"
          ],
          "text": "Helm installs ingress-nginx 4.15.1."
        },
        {
          "edges": [
            "u4"
          ],
          "text": "Its LoadBalancer Service makes AWS create a Network Load Balancer that only accepts your IP."
        },
        {
          "edges": [
            "u4",
            "u2",
            "u1"
          ],
          "text": "Same day, eks-down.ps1 deletes the LoadBalancer Service and PVCs, waits until AWS removes the NLB, destroys eks then network, and runs aws-check.ps1."
        }
      ]
    },
    {
      "id": "request",
      "name": "User request",
      "color": {
        "dark": "#f2a649",
        "light": "#9a5a08"
      },
      "steps": [
        {
          "edges": [
            "r1"
          ],
          "text": "Your browser reaches the NLB. Any other IP is dropped by the source range."
        },
        {
          "edges": [
            "r2"
          ],
          "text": "The NLB forwards to ingress-nginx and keeps your IP (externalTrafficPolicy Local)."
        },
        {
          "edges": [
            "r3"
          ],
          "text": "Planned: an Ingress rule sends ExitZero's host to its Service."
        },
        {
          "edges": [
            "r4",
            "r5"
          ],
          "text": "Planned: in agent mode, ExitZero's call to Claude leaves through the NAT gateway and reaches the Anthropic API."
        }
      ]
    },
    {
      "id": "creds",
      "name": "Credentials",
      "color": {
        "dark": "#e8749f",
        "light": "#a32f63"
      },
      "steps": [
        {
          "edges": [
            "c1",
            "c2"
          ],
          "text": "On main, ci and assistant trade their GitHub OIDC token for the push role. No AWS keys are stored in GitHub."
        },
        {
          "edges": [
            "c3"
          ],
          "text": "On pull requests, terraform-plan gets the read-only plan role."
        },
        {
          "edges": [
            "c4"
          ],
          "text": "eks-up pipes EXITZERO_EKS_ANTHROPIC_KEY into the exitzero-anthropic Secret. It never touches disk or a command line."
        },
        {
          "edges": [
            "c5"
          ],
          "text": "Planned: the ExitZero Deployment reads the key from that Secret."
        }
      ]
    },
    {
      "id": "gitops",
      "name": "GitOps (planned)",
      "color": {
        "dark": "#2fc4b2",
        "light": "#0b6f64"
      },
      "steps": [
        {
          "edges": [
            "g1"
          ],
          "text": "Planned: Argo CD on EKS polls main, as it does on kind today."
        },
        {
          "edges": [
            "g2"
          ],
          "text": "Planned: it applies ExitZero's manifests, pinned to an image SHA."
        }
      ]
    },
    {
      "id": "plan",
      "name": "Plan on PRs",
      "color": {
        "dark": "#a594f5",
        "light": "#5a43b5"
      },
      "steps": [
        {
          "edges": [
            "i1"
          ],
          "text": "A pull request that touches infra/terraform runs terraform-plan."
        },
        {
          "edges": [
            "i2"
          ],
          "text": "The plan reads state from S3 without taking the lock."
        }
      ]
    }
  ],
